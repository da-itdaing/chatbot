config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	extract_query(extract_query)
	full_classify(full_classify<br/>intent+feasibility+case+plan)
	schedule_tool(schedule_tool)
	consume_tool(consume_tool)
	tool_executor(tool_executor<br/>seller_retrieve/web_search)
	analyze_zone_performance(analyze_zone_performance)
	check_allowed_categories(check_allowed_categories)
	generate(generate<br/>RAG 답변 생성)
	basic_generate(basic_generate<br/>일반 답변 생성)
	format_answer(format_answer)
	summarize_messages(summarize_messages)
	truncate_messages(truncate_messages)
	__end__([<p>__end__</p>]):::last
	__start__ --> extract_query;
	analyze_zone_performance --> check_allowed_categories;
	basic_generate --> format_answer;
	check_allowed_categories --> generate;
	consume_tool -. &nbsp;continue&nbsp; .-> analyze_zone_performance;
	consume_tool -. &nbsp;more_tools&nbsp; .-> schedule_tool;
	extract_query --> full_classify;
	format_answer --> summarize_messages;
	full_classify -. &nbsp;general_answer&nbsp; .-> basic_generate;
	full_classify -. &nbsp;rag_answer&nbsp; .-> schedule_tool;
	generate --> format_answer;
	schedule_tool -. &nbsp;resume&nbsp; .-> generate;
	schedule_tool -. &nbsp;tools&nbsp; .-> tool_executor;
	summarize_messages --> truncate_messages;
	tool_executor --> consume_tool;
	truncate_messages --> __end__;
	classDef default fill:#e8f4fc,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#93c5fd

