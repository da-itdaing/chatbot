[Unit]
Description=Itdaing Daily Crawler Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/chatbot
Environment="PATH=/home/ubuntu/chatbot/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/chatbot/chatbot.env
ExecStart=/home/ubuntu/chatbot/.venv/bin/python /home/ubuntu/chatbot/scripts/daily_crawler.py
Restart=always
RestartSec=60
StandardOutput=append:/home/ubuntu/chatbot/logs/daily_crawler.log
StandardError=append:/home/ubuntu/chatbot/logs/daily_crawler_error.log

[Install]
WantedBy=multi-user.target

